# Node modules (will be installed in container)
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
dist/
*/dist/
build/
*/build/

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (use docker-compose env instead)
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker files (don't copy into image)
docker-compose.yml
.dockerignore

# Test files
*.test.ts
*.test.js
**/__tests__/
coverage/

# Documentation (except README)
*.md
!README.md

# Data directories (will be mounted as volumes)
data/
thumbnails/
.thumbnails/
config/

# Temporary files
tmp/
temp/

# Frontend development artifacts
frontend/node_modules/
frontend/dist/
frontend/.next/

# Backend development artifacts
backend/node_modules/
backend/dist/

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma temp files
backend/prisma/migrations/*/migration.sql~
