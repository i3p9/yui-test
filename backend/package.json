{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:scanner": "tsx src/test-scanner.ts",
    "test:db": "tsx src/test-db-ingest.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:scheduler": "node --import tsx --test tests/scan-scheduler.test.ts tests/scan-api.test.ts",
    "test:downloader": "node --import tsx --test tests/downloads.test.ts tests/download-recovery.test.ts",
    "test:downloader:tools": "YUI_RUN_TOOL_TESTS=1 node --import tsx tests/download-toolchain.ts",
    "test:downloader:browser": "node tests/download-browser.mjs",
    "test:downloader:live": "node --import tsx tests/download-live.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "nodemon": "^3.1.11",
    "p-limit": "^7.2.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
